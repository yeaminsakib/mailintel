# MailIntel .gitignore

# Environment variables and secrets
.env
keys
keys/
*.key
*.pem

# Virtual Environment
venv/
env/
.venv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Packaging and build
*.egg-info/
build/
dist/

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/

# Databases
mailintel.db
*.db
*.sqlite
*.sqlite3

# Logs and Output
case_log/
*.log
Project/
scratch/

# Data and Samples
*.eml
!tests/fixtures/*.eml
test_emails/
# (Only ignoring contents of data/, we want to keep data/whitelist.yaml)
data/*
!data/whitelist.yaml

# IDE / OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
