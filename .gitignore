# MailIntel .gitignore

# Environment variables and secrets
.env
keys
keys/
*.key
*.pem

# Virtual Environment
venv/
env/
.venv/
.venv*/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Packaging and build
*.egg-info/
build/
dist/

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/

# Databases
mailintel.db
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Logs and Output
*.log

# Personal project material (brief, slides, recordings) kept next to the code
Project/

# Data and Samples
*.eml
!tests/fixtures/*.eml
# (Only ignoring contents of data/, we want to keep data/whitelist.yaml)
data/*
!data/whitelist.yaml
!data/scoring_weights.yaml
!data/mitre_map.yaml
!data/brands.txt
!data/DATASETS.md

# IDE / OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
